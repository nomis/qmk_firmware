{
    "keyboard_name": "Mechboards Micropad",
    "manufacturer": "Yiancar",
    "maintainer": "yiancar",
    "usb": {
        "vid": "0x1209",
        "pid": "0x0004",
        "device_version": "0.0.1"
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": false
    },
    "qmk": {
        "locking": {
            "enabled": true,
            "resync": true
        }
    },
    "matrix_pins": {
        "cols": ["GP23", "GP20", "GP22", "GP26"],
        "rows": ["GP21"]
    },
    "diode_direction": "COL2ROW",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3, "y": 0}
            ]
        }
    }
}
